# Database (server-only). Required for PostgreSQL (Supabase / Render / Self-hosted).
# Format: postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional: maximum PostgreSQL pool connections (defaults: 10 in production, 5 locally)
DB_MAX_CONNECTIONS=

# 32-byte, base64-encoded key used to encrypt NIN values at rest (generate: openssl rand -base64 32).
NIN_ENCRYPTION_KEY=
# Set a long random secret in production (generate: openssl rand -hex 32).
SESSION_SECRET=

# Force secure cookies on an HTTPS host (true in production; leave blank locally).
COOKIE_SECURE=true

# Server network binding (provided automatically by Render, Railway, etc.)
PORT=3000
HOST=0.0.0.0

# One-time Super Administrator bootstrap (pnpm db:create-admin). Never commit values.
ADMIN_EMAIL=
ADMIN_NAME=
# ADMIN_PASSWORD is optional: the admin bootstrap script can prompt securely.
ADMIN_PASSWORD=

# Official YEGO WhatsApp community/channel (browser-visible).
VITE_WHATSAPP_CHANNEL_URL=

# Google Maps Embed API key (browser-visible, optional). Without it, /map uses the
# keyless embed.
VITE_GOOGLE_MAPS_API_KEY=

# Development only: allow the demo seed when NODE_ENV=production.
ALLOW_DEMO_SEED=
