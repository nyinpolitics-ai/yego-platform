# Database (server-only). Required for SmartWeb VPS PostgreSQL.
DATABASE_URL=

# 32-byte, base64-encoded key used to encrypt NIN values at rest.
NIN_ENCRYPTION_KEY=
# Set a long random secret in production.
SESSION_SECRET=

# One-time bootstrap wizard at /setup?token=... — enables the browser-based
# database initialisation (migrations + first Super Administrator) on hosting
# platforms like Netlify where there is no terminal. Use a long secret phrase
# (20+ characters). Delete the variable and redeploy once setup is done.
SETUP_TOKEN=

# One-time Super Administrator bootstrap (pnpm db:create-admin). Never commit values.
ADMIN_EMAIL=
# ADMIN_PASSWORD is optional: the admin bootstrap script can prompt securely.
ADMIN_NAME=

# Official YEGO WhatsApp community/channel (browser-visible).
VITE_WHATSAPP_CHANNEL_URL=

# Force secure cookies on an HTTPS host; leave blank locally.
COOKIE_SECURE=

# Google Maps Embed API key (browser-visible). Without it, /map uses the
# keyless Google Maps embed.
VITE_GOOGLE_MAPS_API_KEY=

# Development only: allow the demo seed when NODE_ENV=production.
ALLOW_DEMO_SEED=

# Outbound notifications (server-only). Without any provider the platform
# records every message in outbound_messages as "skipped" — nothing is sent
# and nothing is claimed. Configure either provider to start real delivery.
#
# Meta WhatsApp Cloud API (preferred channel when configured):
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
#
# Twilio SMS:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number or a messaging service SID is required:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
#
# Channel selection: auto (default) = WhatsApp if configured, else SMS.
NOTIFY_CHANNEL=
# Set to 1 to disable all outbound delivery (rows are still recorded).
NOTIFY_DISABLED=
